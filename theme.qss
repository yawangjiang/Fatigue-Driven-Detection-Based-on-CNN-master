/* ========================================= */
/* 倦察卫士 - 科技工业风主题 (theme.qss)     */
/* ========================================= */

/* 1. 全局主背景：深邃极夜灰 */
QMainWindow, QWidget#central_widget {
    background-color: #1a1b26;
}

/* 2. 视频监控区外框：科技感边框 */
QFrame#video_frame {
    background-color: #000000;
    border: 2px solid #292e42;
    border-radius: 10px;
}

/* 3. 视频占位文字 */
QLabel#image_label {
    color: #565f89;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 2px;
}

/* 4. 右侧控制面板容器 */
QFrame#right_panel {
    background-color: transparent;
}

/* 5. 数据卡片 (Card) 样式：圆角+微阴影感 */
QFrame#card {
    background-color: #24283b;
    border-radius: 10px;
    border: 1px solid #414868;
}

/* 6. 卡片内的标题文字：青蓝色突显科技感 */
QLabel#card_title {
    color: #7aa2f7;
    font-size: 16px;
    font-weight: bold;
    padding-bottom: 5px;
    border-bottom: 1px solid #414868;
}

/* 7. 普通数据文字 */
QLabel {
    color: #c0caf5;
    font-size: 14px;
    font-family: "Microsoft YaHei", "Segoe UI";
    padding: 2px 0px;
}

/* 8. 危险警告文字专用样式 (如疲劳特征) */
QLabel#warning_label {
    color: #f7768e;
    font-weight: bold;
    font-size: 15px;
}

/* 9. 下拉菜单：极客黑 */
QComboBox {
    background-color: #24283b;
    color: #7aa2f7;
    border: 2px solid #414868;
    border-radius: 6px;
    padding: 8px;
    font-size: 15px;
    font-weight: bold;
}
QComboBox::drop-down { border: none; }
QComboBox:hover { border: 2px solid #7aa2f7; }

/* 10. 按钮大升级 */
QPushButton {
    background-color: #414868;
    color: #c0caf5;
    border-radius: 6px;
    font-size: 16px;
    font-weight: bold;
    padding: 10px;
}
/* 开始按钮：安全绿 */
QPushButton#start_btn { background-color: #9ece6a; color: #1a1b26; }
QPushButton#start_btn:hover { background-color: #b9f27c; }

/* 停止按钮：警示红 */
QPushButton#stop_btn { background-color: #f7768e; color: #1a1b26; }
QPushButton#stop_btn:hover { background-color: #ff98a4; }
QPushButton#stop_btn:disabled { background-color: #414868; color: #565f89; }